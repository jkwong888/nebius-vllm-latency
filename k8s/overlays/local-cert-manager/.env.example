# Non-secret Kustomize build inputs. Edit this file, then run kubectl apply -k k8s/overlays/local-cert-manager.
# Keep credentials in Kubernetes Secrets. MODEL_REVISION remains hardcoded to main.
LLM_HOST=llm.example.com
DNS_ZONE=example.com
ACME_EMAIL=operator@example.com
ACME_ISSUER=letsencrypt-staging
