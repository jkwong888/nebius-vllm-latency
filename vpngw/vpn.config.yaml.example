# Single-gateway BGP over IPsec. Replace placeholders before deploying.
# Private CIDRs and ASNs below are examples. Adjust them for your networks.
version: 1
tenant_id: tenant-REPLACE
project_id: project-REPLACE
region_id: uk-south1
gateway_group:
  name: vpn-gateway
  instance_count: 1
  external_ips: []
  subnet:
    name: vpn-gateway-subnet
    cidr: 10.80.0.0/24
    prefix_length: 24
  vm_spec:
    platform: cpu-d3
    preset: 4vcpu-16gb
    disk_boot_image: ubuntu24.04-driverless
    disk_gb: 100
    disk_type: network_ssd
    disk_block_bytes: 4096
    num_nics: 1
    ssh_private_key_path: /absolute/path/to/id_ed25519
    ssh_public_key_path: /absolute/path/to/id_ed25519.pub
  network_id: ${VPNGW_NETWORK_ID}
gateway:
  local_asn: 65010
  local_prefixes:
  - 10.80.1.0/24
defaults:
  crypto:
    ike_proposals:
    - aes256-sha256-modp2048
    ike_lifetime_seconds: 28800
    esp_proposals:
    - aes256-sha256-modp2048
    esp_lifetime_seconds: 3600
    dh_groups:
    - 14
  dpd:
    interval_seconds: 5
    timeout_seconds: 15
  ha_mode: active-passive
  routing:
    mode: bgp
connections:
- name: remote-site
  vendor: generic
  routing_mode: bgp
  remote_prefixes:
  - 192.168.0.0/24
  bgp:
    enabled: true
    remote_asn: 64560
    advertise_local_prefixes: true
    remote_prefixes:
    - 192.168.0.0/24
  tunnels:
  - name: remote-site-1
    gateway_instance_index: 0
    local_public_ip_index: 0
    ha_role: active
    remote_public_ip: 203.0.113.1
    psk: ${VPN_PSK}
    inner_cidr: 169.254.10.0/30
    inner_local_ip: 169.254.10.1
    inner_remote_ip: 169.254.10.2
